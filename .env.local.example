# Copy this file to .env.local and adjust as needed.
# See docs/ARCHITECTURE.md §3.2 for the full explanation of this toggle.

# "mock" (default) reads data/mock-aircraft.json — reliable, offline-safe.
# "live" fetches from LIVE_API_BASE_URL instead. The exact request/response
# shape for the live provider is still an open item (docs/ARCHITECTURE.md §7)
# — until confirmed, live mode falls back to mock data automatically on error.
DATA_SOURCE=mock

# Only read when DATA_SOURCE=live. airplanes.live is the leading candidate;
# confirm the current endpoint against its documentation before relying on this.
LIVE_API_BASE_URL=https://api.airplanes.live/v2/point/40.7128/-74.006/250
