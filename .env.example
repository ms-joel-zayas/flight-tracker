# The server port used by both the frontend and the API.
PORT=3000

# Uxbridge, Massachusetts. Change these values to track another area.
TRACKING_LAT=42.0773
TRACKING_LON=-71.6295
TRACKING_RADIUS_NM=25

# Live updates and stale-data behavior (REQ-03).
POLL_INTERVAL_MS=30000
STALE_AFTER_SECONDS=60

# Keep only recent history for trails and replay (REQ-06 and REQ-07).
HISTORY_RETENTION_HOURS=24
SQLITE_PATH=backend/data/flight-tracker.db

# ADSB.lol does not currently require a token. The placeholder is here so
# authentication can be enabled later without changing application code.
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_API_TOKEN=
ADSBLOL_USER_AGENT=uxbridge-flight-tracker/1.0 (+https://github.com/ms-joel-zayas/flight-tracker)

# Optional AirLabs enrichment. Leave blank to run using ADSB.lol only.
AIRLABS_BASE_URL=https://airlabs.co/api/v9
AIRLABS_API_KEY=
AIRLABS_CACHE_MINUTES=15
AIRLABS_DAILY_REQUEST_LIMIT=30

# Comma-separated browser origins allowed during separate frontend development.
# The normal same-origin setup does not need this value.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

