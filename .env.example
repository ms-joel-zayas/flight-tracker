# The server port used by both the frontend and the API.
PORT=3000

# Uxbridge, Massachusetts. Change these values to track another area.
TRACKING_LAT=42.0773
TRACKING_LON=-71.6295
TRACKING_RADIUS_NM=25

# Live updates and stale-data behavior (REQ-03).
POLL_INTERVAL_MS=30000
STALE_AFTER_SECONDS=60

# Keep seven days locally, but serve at most one day per replay request.
HISTORY_RETENTION_HOURS=168
REPLAY_MAX_RANGE_HOURS=24
# Day replay defaults to 96 frames: one snapshot every 15 minutes.
REPLAY_STEP_SECONDS=900
SQLITE_PATH=backend/data/flight-tracker.db

# ADSB.fi is the default live-position source; ADSB.lol is its automatic
# fallback. Set this to adsblol to reverse that order. Neither needs a key.
ADSB_POSITION_PROVIDER=adsbfi
ADSBFI_BASE_URL=https://opendata.adsb.fi/api
ADSBFI_USER_AGENT=uxbridge-flight-tracker/1.0 (+https://github.com/ms-joel-zayas/flight-tracker)

# ADSB.lol token placeholder is retained in case authentication is added later.
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_API_TOKEN=
ADSBLOL_USER_AGENT=uxbridge-flight-tracker/1.0 (+https://github.com/ms-joel-zayas/flight-tracker)

# Free, no-key route and selected-aircraft identity lookup.
# This remains useful when ADSB.lol is unavailable.
ADSBDB_BASE_URL=https://api.adsbdb.com
ADSBDB_MAX_CONCURRENCY=4

# Optional AirLabs enrichment. Leave blank to use the free ADSB sources only.
AIRLABS_BASE_URL=https://airlabs.co/api/v9
AIRLABS_API_KEY=
AIRLABS_CACHE_MINUTES=15
AIRLABS_DAILY_REQUEST_LIMIT=30

# Replay works from the first run: when the database has no replay dates, the server loads
# data.json (the Week 8/9 placeholder flights) as yesterday's replay. npm run seed reloads it.
SEED_REPLAY_IF_EMPTY=true

# MENTOR-ONLY demo switch: make the live feed fail on purpose for a presentation.
#   down     the providers fail from the start ("Waiting for live flight data")
#   stale    the first update works, then every update fails (Retrying, then Data stale)
#   empty    the providers answer with no aircraft
#   timeout  /api/aircraft answers after 12 s, longer than the browser waits (10 s)
# Leave blank for normal use. Restart the server after changing it.
DEMO_FAILURE=

# Comma-separated browser origins allowed during separate frontend development.
# The normal same-origin setup does not need this value.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
